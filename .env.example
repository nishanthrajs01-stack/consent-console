# PayPal Sandbox Credentials (from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# AI Model Keys (Gemini is free-tier recommended per guide; OpenAI as fallback)
GEMINI_API_KEY=your_gemini_api_key
# or GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=optional_fallback_openai_key
